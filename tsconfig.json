{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "capture-nepal": ["./src/nepal"],
      "capture-nepal/*": ["./src/nepal/*"]
    }
  },
  "include": ["src/nepal", "src/core_modules/capture-core-utils"],
  "exclude": ["node_modules", "dist", "src/core_modules/capture-ui"]
}
