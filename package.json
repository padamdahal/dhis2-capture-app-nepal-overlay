{
  "name": "dhis2-capture-app-nepal-overlay",
  "version": "1.0.0",
  "private": true,
  "description": "Nepal-only overlay repository for DHIS2 Capture NP (BS calendar, custom branding, fast 2s feature rebuilds)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "node nepal/scripts/standalonePreview.mjs --build-dist",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "overlay": "node nepal/scripts/applyOverlayToBase.mjs",
    "build:full": "node nepal/scripts/applyOverlayToBase.mjs --build-full",
    "build:fast": "node nepal/scripts/applyOverlayToBase.mjs --build-fast",
    "build:ext": "node nepal/scripts/buildExtension.mjs --out dist"
  },
  "dependencies": {
    "@dhis2/ui": "^10.21.1",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitejs/plugin-react": "^6.3.0",
    "nepali-date-converter": "^3.4.2",
    "react": "18",
    "react-dom": "18",
    "styled-jsx": "^4",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  }
}
